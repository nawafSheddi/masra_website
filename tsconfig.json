{
  /* Astro's strict preset: strict TS, bundler resolution, .astro support. */
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    /* Catch animation-target typos and dead code at check time. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    /* Node built-ins for build-time code, scripts and node --test files. */
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*"],
  "exclude": ["dist", "node_modules"]
}
