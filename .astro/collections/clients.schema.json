{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "nameAr": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "category": {
      "type": "string",
      "enum": [
        "artistic",
        "lifestyle",
        "menu"
      ]
    },
    "year": {
      "type": "string",
      "pattern": "^\\d{4}$"
    },
    "tags": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "palette": {
      "type": "object",
      "properties": {
        "bg": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "bgElevated": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "inkDim": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "bg",
        "bgElevated",
        "ink",
        "inkDim",
        "accent"
      ]
    },
    "lead": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "alt": {
          "type": "string",
          "minLength": 3
        },
        "caption": {
          "type": "object",
          "properties": {
            "ar": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "ar",
            "en"
          ]
        }
      },
      "required": [
        "image",
        "alt"
      ]
    },
    "frames": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string"
          },
          "alt": {
            "type": "string",
            "minLength": 3
          },
          "caption": {
            "type": "object",
            "properties": {
              "ar": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ar",
              "en"
            ]
          }
        },
        "required": [
          "image",
          "alt"
        ]
      }
    },
    "layout": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "theatrical"
            },
            "sceneHeight": {
              "default": 2,
              "type": "number",
              "minimum": 1,
              "maximum": 2.5
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "strip"
            },
            "sceneHeight": {
              "default": 2,
              "type": "number",
              "minimum": 1,
              "maximum": 2.5
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "label"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stilllife"
            },
            "sceneHeight": {
              "default": 2,
              "type": "number",
              "minimum": 1,
              "maximum": 2.5
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "picnic"
            },
            "sceneHeight": {
              "default": 2,
              "type": "number",
              "minimum": 1,
              "maximum": 2.5
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "scrub"
            },
            "sceneHeight": {
              "default": 2.5,
              "type": "number",
              "minimum": 1,
              "maximum": 2.5
            },
            "sequence": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "const": "shaya"
                },
                "alt": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "required": [
                "id",
                "alt"
              ]
            },
            "loops": {
              "minItems": 2,
              "maxItems": 2,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "video": {
                    "type": "string",
                    "enum": [
                      "shaya-loop-1",
                      "shaya-loop-2"
                    ]
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 3
                  }
                },
                "required": [
                  "video",
                  "alt"
                ]
              }
            },
            "counterPrefix": {
              "default": "F",
              "type": "string"
            },
            "hint": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "sequence",
            "loops",
            "hint"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "gift"
            },
            "sceneHeight": {
              "default": 1.5,
              "type": "number",
              "minimum": 1,
              "maximum": 2.5
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "documentary"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "order",
    "category",
    "year",
    "tags",
    "description",
    "palette",
    "lead",
    "frames",
    "layout"
  ]
}