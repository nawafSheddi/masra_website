# Copy to .env (never commit .env). Only needed for the optional R2 setup —
# see docs/guides/move-images-to-r2.md.

# Bucket that `npx pnpm media:upload` copies images/video into.
R2_BUCKET=masra-media

# Where the site loads images/video from. Leave empty (or delete) to serve
# them from the site itself. In production set this in the Cloudflare build
# settings instead of here.
PUBLIC_MEDIA_BASE_URL=
