# Cloudflare cache policy (Pages and Workers static assets both read this).
#
# Optimized images, video, fonts and Astro's hashed build files never change
# at their URL (a new photo always gets a new file name), so they are cached
# "immutable" for a year. HTML is revalidated on every visit (default), so
# content edits show up as soon as a deploy finishes.
/images/*
  Cache-Control: public, max-age=31536000, immutable
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/video/*
  Cache-Control: public, max-age=31536000, immutable

# Files that are replaced IN PLACE (same file name) must not be immutable:
# client logos (see src/content/featured-clients.yaml) and per-client share
# cards (regenerated when a lead photo changes). "! Cache-Control" removes
# the inherited header; one day keeps them fast but updatable.
/images/clients/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
/images/og/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
