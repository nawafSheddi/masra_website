# Dependencies / build output
node_modules/
dist/

# Raw photography (originals live in the studio's Google Drive). Import with
# `npx pnpm media:add`, which never copies the original into the repo; if
# you keep raw files in assets/, they are never committed.
# The optimized web versions in public/images ARE committed.
assets/

# Note: brand_assets/ (the official brand kit: guidelines, fonts, logo
# masters) IS tracked on purpose, so anyone working on the site has it.

# OS noise
.DS_Store

# Local env (secrets: R2 / Cloudflare keys) — never commit
.env
.env.*
!.env.example

# Cloudflare wrangler local state (created by `wrangler pages dev`)
.wrangler/

# Local-only notes and dev history (kept on the developer's machine)
.local/
*.local.md

# Astro generated types (recreated by `astro sync` / dev / build)
.astro/

# media-add/remove lock (only exists while a media command runs)
src/generated/.media.lock
